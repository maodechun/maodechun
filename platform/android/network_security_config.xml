<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置

  策略：
    - 全局禁止明文流量（cleartextTrafficPermitted=false）
    - FTP 备份若使用明文 FTP，需在此为具体域名开例外
    - 强烈建议保持禁止，强制用户使用 FTPS

  放置位置：android/app/src/main/res/xml/network_security_config.xml
-->
<network-security-config>

    <!-- 默认：禁止一切明文流量 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      例外：仅当用户明确使用明文 FTP 时才需要解开注释。

      ⚠️ 安全提示：解开后该域名的所有明文流量都会被放行，
      存在被中间人攻击的风险。建议引导用户使用 FTPS。

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ftp.example.com</domain>
    </domain-config>
    -->

</network-security-config>
