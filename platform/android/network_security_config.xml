<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置

  策略：
    - 允许明文流量：FTP 备份会优先尝试 FTPS（显式 TLS），
      若用户服务器不支持加密则自动降级为普通 FTP。
      若此处禁止明文，降级后的明文 FTP 会被系统层面拦截，
      用户看到的现象就是「根本没有连接上 FTP 服务器」。
    - 备份文件本身已用 DT 专有强加密（AES-256-GCM + HMAC），
      即使走明文 FTP，服务器与网络中间人也拿不到密钥内容。

  放置位置：android/app/src/main/res/xml/network_security_config.xml
-->
<network-security-config>

    <!-- 默认：允许明文流量（仅用于兼容用户自建 FTP 服务器） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
